# Webshop Database Configuration
# Copy this file to .env and customize for your environment
# NEVER commit .env to version control

# ============================================================================
# DATABASE CONNECTION
# ============================================================================
# Database type: postgresql or sqlite
DB_TYPE=postgresql

# PostgreSQL settings (used when DB_TYPE=postgresql)
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=webshop
PG_USER=postgres
PG_PASSWORD=changeme

# SQLite settings (used when DB_TYPE=sqlite or as fallback)
SQLITE_DB_PATH=./webshop.sqlite

# ============================================================================
# SETUP BEHAVIOR
# ============================================================================
# Auto-create database if it doesn't exist (true/false)
AUTO_CREATE_DB=true

# Run schema migration after creating/connecting to database (true/false)
AUTO_RUN_SCHEMA=true